<Window x:Class="TronEvolutionPatcher.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:TronEvolutionPatcher.Models"
        Title="TRON: Evolution Patcher 1.0.0" Icon="/Assets/app.ico" Width="1000" Height="940" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}" Loaded="OnLoaded" Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,12">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Image Source="/Assets/logo.png" Width="52" Height="52" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="TRON: EVOLUTION" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="DirectX 9 / Vulkan · FPS и портативность · v1.0.0" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel>
                <Button Grid.Column="2" Command="{Binding SupportCommand}" VerticalAlignment="Center" ToolTip="Поддержать CodoMagia на Boosty" AutomationProperties.Name="Поддержать">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="13" Height="13" Stretch="Uniform" Fill="#E11D48" Margin="0,0,5,0" VerticalAlignment="Center"
                              Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z" />
                        <TextBlock Text="Поддержать" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="ПАПКА ИГРЫ" Style="{StaticResource Caption}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="GamePathBox" Text="{Binding DirectoryInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" ToolTip="Корень игры, Binaries\Win32Live или путь к GridGame.exe"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SelectDirectoryCommand}" /></TextBox.InputBindings></TextBox>
                    <Button Grid.Column="1" Content="Открыть" Command="{Binding SelectDirectoryCommand}" Margin="8,0,0,0" /><Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" /><Button Grid.Column="3" Content="Найти" Command="{Binding DiscoverCommand}" Margin="8,0,0,0" ToolTip="Поиск рядом с патчером, без сканирования дисков" />
                </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedText}" /><Style.Triggers>
                        <DataTrigger Binding="{Binding Renderer}" Value="{x:Static models:RendererState.Vulkan}"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Renderer}" Value="{x:Static models:RendererState.DirectX9}"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Renderer}" Value="{x:Static models:RendererState.Unknown}"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock><TextBlock Text="{Binding StatusDetails}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,8,15,0" /></StackPanel>
                <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Padding="12,7" />
            </Grid></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="ГРАФИЧЕСКИЙ API" Style="{StaticResource Caption}" />
                <UniformGrid Columns="2" Margin="0,1,0,9"><Button Content="Переключить на Vulkan" Command="{Binding VulkanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" /><Button Content="Вернуть DirectX 9" Command="{Binding DirectXCommand}" Margin="5,0,0,0" /></UniformGrid>
                <WrapPanel IsEnabled="{Binding CanUseGame}"><CheckBox x:Name="HudCheck" Content="Оверлей DXVK HUD" IsChecked="{Binding HudEnabled}" ToolTip="FPS, устройство и API. В Vulkan изменение сохраняется сразу." /><CheckBox Content="Анизотропная фильтрация 16x" IsChecked="{Binding AnisotropyEnabled}" ToolTip="В Vulkan изменение сохраняется сразу." /></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="НАСТРОЙКИ ИГРЫ" Style="{StaticResource Caption}" />
                <Grid IsEnabled="{Binding CanEditSettings}" Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Разрешение" Style="{StaticResource Caption}" /><ComboBox x:Name="ResolutionBox" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Resolutions}" Text="{Binding ResolutionText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Лимит FPS" Style="{StaticResource Caption}" /><ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding FpsOptions}" Text="{Binding FpsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="62 / 120 / 144 / 165 / 200 FPS или без лимита. Рекомендуется не более 200 FPS во избежание сбоев физики." /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Язык" Style="{StaticResource Caption}" /><ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Languages}" Text="{Binding LanguageCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="RUS — русский, INT — английский" /></StackPanel>
                </Grid>
                <WrapPanel IsEnabled="{Binding CanEditSettings}" Margin="0,2,0,8"><CheckBox Content="Размытие в движении" IsChecked="{Binding MotionBlur}" /><CheckBox Content="Вертикальная синхронизация" IsChecked="{Binding VSync}" /></WrapPanel>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,0,0,10"><WrapPanel>
                    <CheckBox Content="Автономный запуск (No-Registry)" IsChecked="{Binding NoRegistry}" IsEnabled="{Binding CanEditSettings}" />
                    <CheckBox Content="Сохранения и настройки внутри игры" IsChecked="{Binding UserDirectory}" IsEnabled="{Binding CanRedirectUserData}" ToolTip="Папка UserData. Существующие профили не объединяются и не перезаписываются." />
                </WrapPanel></Border>
                <StackPanel Margin="0,0,0,10">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ProfileNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding ProfileNotice}" TextWrapping="Wrap" Foreground="#FFD38A" FontSize="12" Margin="0,0,0,8" />
                    <Button Content="Копировать профиль" Command="{Binding CopyProfileCommand}" HorizontalAlignment="Left" ToolTip="Копировать профиль из другого расположения в выбранное. Исходник сохраняется; целевая папка должна быть пустой." />
                </StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding IniDescription}" Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding IniPath}" TextWrapping="Wrap" Margin="0,0,10,0" />
                    <Button Grid.Column="1" Content="Применить настройки" Command="{Binding ApplyCommand}" Background="#4738AE" BorderBrush="#8177EC" />
                </Grid>
            </StackPanel></Border>
            <Button x:Name="LaunchButton" Content="ЗАПУСТИТЬ ИГРУ" Command="{Binding LaunchCommand}" Background="#087959" BorderBrush="#20BC94" Padding="16,13" Margin="0,0,0,12" FontSize="14" />
            <Border Background="#301D29" BorderBrush="#704051" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
            </Border>
            <Grid Margin="1,0,1,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="ЖУРНАЛ ОПЕРАЦИЙ" Style="{StaticResource Caption}" Margin="0" /><TextBlock Grid.Column="1" Text="{Binding OperationStatus}" FontSize="11" Foreground="{StaticResource MutedText}" /></Grid>
            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBackground}" Margin="0,0,0,6" />
            <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="112" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedText}" VerticalContentAlignment="Top" TextChanged="OnLogChanged" />
            <TextBlock Text="CodoMagia · TRON: Evolution Patcher" HorizontalAlignment="Right" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,9,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
