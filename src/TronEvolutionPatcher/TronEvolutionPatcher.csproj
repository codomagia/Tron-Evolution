<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>TronEvolutionPatcher</RootNamespace>
    <AssemblyName>TronEvolutionPatcher</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>TRON: Evolution Patcher</Product>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Resource Include="Assets/logo.png" />
    <Resource Include="Assets/app.ico" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="TronEvolutionPatcher.Licenses.MIT.txt" />
    <EmbeddedResource Include="Assets/LICENSE.dxvk.txt" LogicalName="TronEvolutionPatcher.Licenses.DXVK.txt" />
    <None Update="Assets/vk09.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/LICENSE.dxvk.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
